APP_NAME=Fake Job Detector API
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (SQLite for dev, PostgreSQL URL for production)
DATABASE_URL=sqlite:///./fake_job_detector.db

# Model artifact path (relative to backend/ root)
MODEL_PATH=models/job_detector.pkl
MODEL_NAME=TF-IDF + Logistic Regression
MODEL_VERSION=1.0

# Configurable risk presentation thresholds
RISK_MEDIUM_MIN=0.35
RISK_HIGH_MIN=0.70

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request & document upload safety limits
MAX_REQUEST_BYTES=65536
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=25
OCR_MIN_CHARS_PER_PAGE=60
OCR_DPI=200
OCR_TIMEOUT_SECONDS=20
